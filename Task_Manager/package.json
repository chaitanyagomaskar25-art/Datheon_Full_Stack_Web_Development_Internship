{
  "name": "task-manager-monorepo",
  "version": "1.0.0",
  "description": "Full-stack SaaS Task Management Dashboard (Tasker) with React client and Express/MongoDB server",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "client:lint": "npm run lint --prefix client",
    "client:preview": "npm run preview --prefix client",
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server"
  },
  "keywords": [
    "task-manager",
    "react",
    "express",
    "mongodb",
    "vite",
    "tailwindcss",
    "fullstack"
  ],
